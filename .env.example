# Optional. Leave every one of these unset and the app still works out of the box
# using the keyless Pollinations provider. Set a key here to give every visitor
# a working shared provider without them configuring anything.
OPENCODE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=

# Set to 1 only if you self-host and want to allow localhost / LAN endpoints.
ALLOW_PRIVATE_ENDPOINTS=0

# Used for the OpenRouter referer header.
PUBLIC_SITE_URL=
